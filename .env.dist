# Copy this file to `.env` and fill in your Solarman Open API credentials.
# `.env` is gitignored. Values here are read by `just test-live` and by any
# recipe that invokes pytest (just loads .env automatically).
#
# The four variables are mandatory; if any is empty or missing,
# tests/test_live.py will be skipped.

SOLARMAN_EMAIL=
SOLARMAN_PASSWORD=
SOLARMAN_APP_ID=
SOLARMAN_APP_SECRET=
